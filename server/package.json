{
  "name": "server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false --include ../.env --env-file-if-exists=../.env src/index.ts",
    "dev:debug": "tsx watch --clear-screen=false --include ../.env --env-file-if-exists=../.env --inspect src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=../.env dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "fixtures": "tsx scripts/fetchFixtures.ts",
    "verify:pump": "tsx scripts/verifyPump.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/static": "^10.1.6",
    "@fastify/websocket": "^11.3.4",
    "@pump-fun/pump-sdk": "^4.1.0",
    "@pump-fun/pump-swap-sdk": "^2.1.0",
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.99.0",
    "better-sqlite3": "^13.0.3",
    "bn.js": "^5.2.5",
    "bs58": "^6.0.0",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "pino-roll": "^4.0.0",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/bn.js": "^5.2.0",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.2",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
