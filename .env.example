# Copy this file to .env and fill in the values.
# In dev mode (`pnpm dev`) the server restarts automatically when you save this file.
# In Docker, run `docker compose up -d` again after editing (a plain restart does not reload it).

# ── Helius (wallet monitoring + RPC) ─────────────────────────────────────────
# Get a key at https://dashboard.helius.dev
HELIUS_API_KEY=
# Project id from the Helius dashboard – shows real credit usage in the header
HELIUS_PROJECT_ID=

# free      = standard logsSubscribe + getTransaction lookup (works on the free plan, ~1 s slower)
# developer = Enhanced WebSocket transactionSubscribe (needs the $49/mo Developer plan or higher)
HELIUS_TIER=free

# Optional overrides (defaults are built from HELIUS_API_KEY)
# RPC_URL=https://mainnet.helius-rpc.com/?api-key=...
# WS_URL=wss://mainnet.helius-rpc.com/?api-key=...

# Max RPC requests per second the bot may use (default: 10 on free, 50 on developer; free is capped at 10)
# RPC_RPS=10

# Helius Sender endpoint for direct pump.fun trades (no credits used; the tip pays for it).
# The global https endpoint routes to the nearest region – keep it. The regional ones (e.g.
# http://fra-sender.helius-rpc.com/fast) are plain http, so the bot sends them no API key and you get
# Sender's keyless limit of 1 transaction per second instead of 50.
# SENDER_URL=https://sender.helius-rpc.com/fast

# ── Telegram notifications (optional) ───────────────────────────────────────
# Create a bot with @BotFather, send it any message, then put its token and your chat id here.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Jupiter (swaps, prices, token info) ──────────────────────────────────────
# Free key at https://portal.jup.ag
JUPITER_API_KEY=
# Requests per second allowed by your Jupiter plan (free = 1). Swaps get priority over price refreshes.
JUPITER_RPS=1

# ── Safety ───────────────────────────────────────────────────────────────────
# Master switch. While false, no real transaction is ever sent – groups set to "live" are skipped,
# paper groups keep working. Turn on only when you are ready to trade real SOL.
LIVE_TRADING=false

# Optional: unlock the keystore automatically on start, so the bot can resume trading after a crash
# or reboot without you typing the passphrase. Convenient, but anyone who can read this file can
# then use your trading wallets. Leave empty to unlock from the web page instead. Put it in single
# quotes – an unquoted # starts a comment and cuts the passphrase off: KEYSTORE_PASSPHRASE='…'
KEYSTORE_PASSPHRASE=

# ── Web UI / server ──────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8787

# Where the database, keystore and logs live (default: ./data in the project root)
# DATA_DIR=./data

# trace | debug | info | warn | error   (debug shows raw transaction parsing details)
LOG_LEVEL=info
# Pretty colored logs (default: on when running in a terminal)
# LOG_PRETTY=true
