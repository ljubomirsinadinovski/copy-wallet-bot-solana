# Manual trading – read after the project's .env, so these win (for manual/run.sh only).

# Its own data folder: the manual wallets (keys encrypted), positions and trade history.
# Git-ignored (data-*/). Never point this at the copy bot's data folder while the bot runs.
DATA_DIR=./data-manual

# Real trades. false = only paper (simulated) trades are possible.
LIVE_TRADING=true

# Empty: log in on the page (the .env passphrase belongs to another data folder). Set to this data
# folder's passphrase to unlock the wallets on start, so sell plans go on after a restart. Put it in
# single quotes – an unquoted # starts a comment and cuts the passphrase off: KEYSTORE_PASSPHRASE='…'
KEYSTORE_PASSPHRASE=

# The page: http://127.0.0.1:8790
MANUAL_PORT=8790
